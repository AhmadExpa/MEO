# Public application URL. Use your HTTPS domain in production.
APP_URL=http://localhost:3000

# Optional HTTPS URL for the logo shown on Stripe-hosted Checkout.
# Example: https://payments.example.com/elevenorbits-logo.svg
ELEVENORBITS_LOGO_URL=

# Use a Stripe test key during development and switch to live only after testing.
STRIPE_SECRET_KEY=sk_test_replace_me

# 32+ random characters. Used to encrypt and authenticate stateless payment links.
PAYMENT_LINK_SECRET=replace_with_a_long_random_secret

# Merchant-only dashboard login. Generate a password hash with:
# npm run hash-password -- "your-strong-password"
MERCHANT_EMAIL=owner@example.com
MERCHANT_PASSWORD_HASH=
AUTH_SECRET=replace_with_a_long_random_secret
