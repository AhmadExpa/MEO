# Public application URL. Use your HTTPS domain in production.
APP_URL=https://merchant.elevenorbits.com

# Optional HTTPS URL for the logo shown on Stripe-hosted Checkout.
# Example: https://merchant.elevenorbits.com/elevenorbits-logo.png
ELEVENORBITS_LOGO_URL=https://merchant.elevenorbits.com/elevenorbits-logo.png

# Use a Stripe test key during development and switch to live only after testing.
STRIPE_SECRET_KEY=sk_test_replace_me

# Private customer portal login. Use one fixed username and password for clients.
# Generate the password hash with:
# npm run hash-password -- "your-strong-password"
PORTAL_USERNAME=your-client-username
PORTAL_PASSWORD_HASH=
AUTH_SECRET=replace_with_a_long_random_secret
